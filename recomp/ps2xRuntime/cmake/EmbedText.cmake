# ps2x_embed_text(<output header> <name> <file> [<name> <file>]...)
# Writes a C++ header in which each file's text is `static const char *const
# <name>[]`: raw-string pieces of at most 8000 characters (MSVC limits a single
# string literal to 16 KB), ended by nullptr. Written at configure time, and
# only when the text changed; editing an input file re-runs CMake.
function(ps2x_embed_text output)
    set(text "// Generated by cmake/EmbedText.cmake. Do not edit.\n#pragma once\n")
    set(args ${ARGN})
    list(LENGTH args count)
    math(EXPR last "${count} - 1")
    foreach(i RANGE 0 ${last} 2)
        math(EXPR j "${i} + 1")
        list(GET args ${i} name)
        list(GET args ${j} file)
        file(READ "${file}" content)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        string(LENGTH "${content}" length)
        string(APPEND text "static const char *const ${name}[] = {\n")
        set(pos 0)
        while(pos LESS length)
            string(SUBSTRING "${content}" ${pos} 8000 piece)
            string(APPEND text "R\"PS2XEMBED(${piece})PS2XEMBED\",\n")
            math(EXPR pos "${pos} + 8000")
        endwhile()
        string(APPEND text "nullptr};\n")
    endforeach()
    file(WRITE "${output}.tmp" "${text}")
    configure_file("${output}.tmp" "${output}" COPYONLY)
endfunction()
