// GT4 Recompilation (Classic edition) launcher resources: the icon (also GLFW's window icon), the
// preview pictures (GT4 frames, 640x448, from analysis/phase4/milestones) and the About page's
// "How it works" text (analysis/launcher-v3/about-text/HOW-IT-WORKS-FULL.md, byte for byte).
#include "gt4stock_resources.h"
#include <winver.h>

1 ICON "gt4stock.ico"
GLFW_ICON ICON "gt4stock.ico"

GT4STOCK_IDR_RACE RCDATA "gt4stock_race.png"
GT4STOCK_IDR_MENU RCDATA "gt4stock_menu.png"
GT4STOCK_IDR_TITLE RCDATA "gt4stock_title.png"
GT4STOCK_IDR_HOWTO RCDATA "gt4stock_how_it_works.md"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,2,0
 PRODUCTVERSION 1,4,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GT4 Recompilation (Classic)"
            VALUE "FileVersion", "1.4.2"
            VALUE "InternalName", "GT4Recompilation"
            VALUE "OriginalFilename", "GT4Recompilation.exe"
            VALUE "ProductName", "GT4 Recompilation"
            VALUE "ProductVersion", "1.4.2 Classic"
            VALUE "Comments", "An unofficial, fan-made native Windows recompilation for personal use. Not affiliated with Sony or Polyphony Digital."
            VALUE "LegalTrademarks", "Gran Turismo is a trademark of Sony Interactive Entertainment."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
