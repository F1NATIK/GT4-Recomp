VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,5,0,0
 PRODUCTVERSION 1,5,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GT4 Recompilation"
            VALUE "FileVersion", "1.5.0"
            VALUE "InternalName", "GT4RecompilationFull"
            VALUE "OriginalFilename", "GT4RecompilationFull.exe"
            VALUE "ProductName", "GT4 Recompilation"
