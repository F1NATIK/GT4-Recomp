// GT4 Recompilation (Full edition) launcher resources: the Classic edition's icon, preview pictures and "How it works"
// text (gt4stock.rc; the same files), with the Full edition's own version block.
#include "gt4stock_resources.h"
#include <winver.h>

1 ICON "gt4stock.ico"
