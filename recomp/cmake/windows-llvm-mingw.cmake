set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED ENV{LLVM_MINGW_ROOT})
    message(FATAL_ERROR "Set LLVM_MINGW_ROOT to the extracted LLVM-MinGW toolchain directory")
endif()
file(TO_CMAKE_PATH "$ENV{LLVM_MINGW_ROOT}" LLVM_MINGW_ROOT)
set(CMAKE_C_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang${CMAKE_HOST_EXECUTABLE_SUFFIX}")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++${CMAKE_HOST_EXECUTABLE_SUFFIX}")
set(CMAKE_RC_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres${CMAKE_HOST_EXECUTABLE_SUFFIX}")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CXX_FLAGS_INIT "-msse4.1 -gcodeview")
set(CMAKE_C_FLAGS_INIT "-gcodeview")
# libc++ and libunwind inside the exe (no llvm-mingw DLLs next to it); debug info in a .pdb beside it, as MSVC does
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -Wl,--pdb=")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-static -Wl,--pdb=")
